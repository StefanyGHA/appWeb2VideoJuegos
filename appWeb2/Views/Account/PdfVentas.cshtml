@model List<VentaViewModel>

@{
    Layout = null;
    var usuario = Context.Session.GetString("usuario");

    DateTime? fechaDesde = ViewBag.Desde as DateTime?;
    DateTime? fechaHasta = ViewBag.Hasta as DateTime?;

    string desde = fechaDesde.HasValue
        ? fechaDesde.Value.ToString("dd/MM/yyyy")
        : "";

    string hasta = fechaHasta.HasValue
        ? fechaHasta.Value.ToString("dd/MM/yyyy")
        : "";

    var totalGeneral = Model.Sum(x => x.total);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <style>
            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 12px;
                color: #222;
                margin: 0;
                padding: 0;
            }

            .header {
                border-bottom: 4px solid #111f33;
                padding-bottom: 15px;
                margin-bottom: 25px;
            }

            .header-table {
                width: 100%;
            }

            .logo-box {
                width: 120px;
                height: 70px;
                border: 2px solid #111f33;
                border-radius: 8px;
                text-align: center;
                vertical-align: middle;
                font-weight: bold;
                color: #111f33;
            }

            .title {
                text-align: center;
            }

                .title h1 {
                    margin: 0;
                    font-size: 26px;
                    color: #111f33;
                    text-transform: uppercase;
                }

                .title p {
                    margin: 5px 0 0;
                    font-size: 13px;
                    color: #555;
                }

            .info-box {
                background: #f2f4f8;
                border: 1px solid #d8dde6;
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 20px;
            }

            .info-table {
                width: 100%;
                font-size: 12px;
            }

                .info-table td {
                    padding: 4px 8px;
                }

            .label {
                font-weight: bold;
                color: #111f33;
            }

            table.report {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }

                table.report thead {
                    background: #111f33;
                    color: white;
                }

                table.report th {
                    padding: 10px 6px;
                    font-size: 11px;
                    text-transform: uppercase;
                    border: 1px solid #111f33;
                }

                table.report td {
                    padding: 8px 6px;
                    border: 1px solid #ddd;
                    font-size: 11px;
                }

                table.report tbody tr:nth-child(even) {
                    background: #f7f9fc;
                }

            .text-center {
                text-align: center;
            }

            .text-right {
                text-align: right;
            }

            .estado {
                font-weight: bold;
                color: #0b7a3b;
            }

            .codigo {
                color: #9a6a00;
                font-weight: bold;
            }

            .summary {
                margin-top: 25px;
                width: 100%;
            }

                .summary td {
                    padding: 8px;
                    font-size: 13px;
                }

                .summary .total {
                    background: #111f33;
                    color: white;
                    font-weight: bold;
                    text-align: right;
                }

            .footer-note {
                margin-top: 35px;
                font-size: 10px;
                color: #666;
                text-align: center;
                border-top: 1px solid #ccc;
                padding-top: 10px;
            }
    </style>
</head>

<body>

    <div class="header">
        <table class="header-table">
            <tr>
                <td style="width: 140px; text-align: left; vertical-align: middle;">
                    <img src="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/logoamarillo.png")"
                         style="width: 120px;" />
                </td><br />

             
                <td style="width: 140px; text-align: right; font-size: 11px;">
                    <strong>Generado por:</strong><br />
                    @usuario<br /><br />
                    <strong>Fecha:</strong><br />
                    @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </td>
            </tr>
        </table>
    </div>

    <div class="info-box">
        <table class="info-table">
            <tr>
                <td><span class="label">Cantidad de registros:</span> @Model.Count</td>
            </tr>
        </table>
    </div>

    <table class="report">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Videojuego</th>
                <th>Título</th>
                <th>Cantidad</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Código</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@item.NombreCliente</td>
                    <td class="text-center">@item.NombreVideojuego</td>
                    <td>@item.titulo</td>
                    <td class="text-center">@item.cantidad</td>
                    <td class="text-right">$@item.total.ToString("N2")</td>
                    <td class="text-center estado">@item.estadoCompra</td>
                    <td class="text-center">@item.fechaHoraTransacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-center codigo">@item.codigoTransaccion</td>
                </tr>
            }
        </tbody>
    </table>

    <table class="summary">
        <tr>
            <td></td>
        </tr>
    </table>

    <div class="footer-note">
        Este documento fue generado automáticamente por el sistema.
    </div>

</body>
</html>