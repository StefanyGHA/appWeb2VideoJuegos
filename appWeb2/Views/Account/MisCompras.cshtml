@model List<appWeb2.Models.DetalleCompra>

@{
    ViewData["Title"] = "Mis Compras";
}

<h2 class="text-warning mb-4">Mis videojuegos comprados</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <input type="date" name="desde" class="form-control"
               value="@ViewBag.Desde?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3">
        <input type="date" name="hasta" class="form-control"
               value="@ViewBag.Hasta?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-4">
        <input type="text" name="videojuego" class="form-control"
               placeholder="Nombre del videojuego"
               value="@ViewBag.Videojuego" />
    </div>

    <div class="col-md-2">
        <button class="btn btn-warning w-100">Filtrar</button>
    </div>
</form>

<a asp-controller="Account"
       asp-action="ReporteMisComprasPdf"
       asp-route-desde="@ViewBag.Desde"
       asp-route-hasta="@ViewBag.Hasta"
       asp-route-videojuego="@ViewBag.Videojuego"
       class="btn btn-danger mb-3">
    📄 Descargar PDF
</a>

<table class="table table-dark table-hover text-center">
    <thead class="table-warning text-dark">
        <tr>
            <th>Videojuego</th>
            <th>Cantidad</th>
            <th>Total</th>
            <th>Estado</th>
            <th>Fecha</th>
            <th>Código</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VideoJuegos.titulo</td>
                <td>@item.cantidad</td>
                <td>$@item.total</td>
                <td>@item.estadoCompra</td>
                <td>@item.fechaHoraTransaccion.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.codigoTransaccion</td>
            </tr>
        }
    </tbody>
</table>