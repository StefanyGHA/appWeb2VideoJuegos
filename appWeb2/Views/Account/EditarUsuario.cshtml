@model appWeb2.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 bg-dark text-white">
        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">Editar Usuario</h3>
        </div>

        <div class="card-body">
            <form asp-action="EditarUsuario" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="nombre" class="form-control" />
                    <span asp-validation-for="nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input asp-for="correo" class="form-control" />
                    <span asp-validation-for="correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <select asp-for="IdRol" class="form-select">
                        @foreach (var rol in ViewBag.Roles)
                        {
                            <option value="@rol.IdRol">@rol.rol</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Guardar Cambios
                    </button>

                    <a asp-action="VerUsuarios" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>