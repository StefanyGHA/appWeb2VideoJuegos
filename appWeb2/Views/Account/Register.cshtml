@model appWeb2.Models.Usuario
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
                background: linear-gradient(135deg, #6A5ACD, #2a5298);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .register-card {
            width: 100%;
            max-width: 450px;
            border-radius: 20px;
            padding: 30px;
            background: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .btn-accent {
            background: #2a5298;
            color: white;
            border-radius: 10px;
        }

        .btn-accent:hover {
                    background: #6A5ACD;
        }

        .form-control {
            border-radius: 10px;
        }

        .title {
            font-weight: bold;
            color: #2a5298;
        }
    </style>
</head>
<body>

    <div class="register-card">

        <h3 class="text-center mb-4 title">Crear Cuenta</h3>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <!-- NOMBRE -->
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="nombre" class="form-control" placeholder="Tu nombre" />
            </div>

            <!-- CORREO -->
            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input asp-for="correo" class="form-control" placeholder="ejemplo@gmail.com" />
            </div>

            <!-- PASSWORD -->
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input name="password" type="password" class="form-control" placeholder="••••••••" />
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="mb-3">
                <label class="form-label">Confirmar Contraseña</label>
                <input name="confirmPassword" type="password" class="form-control" placeholder="••••••••" />
            </div>

            <button type="submit" class="btn btn-accent w-100 py-2">
                Registrarse
            </button>

            <div class="text-center mt-3">
                <small>¿Ya tienes cuenta?</small>
                <a asp-controller="Account" asp-action="Login">Inicia sesión</a>
            </div>

        </form>

    </div>

</body>
</html>