@model appWeb2.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 bg-dark text-white">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Eliminar Usuario</h3>
        </div>

        <div class="card-body">
            <h5 class="text-warning mb-4">
                ¿Estás segura de que deseas eliminar este usuario?
            </h5>

            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.nombre</dd>

                <dt class="col-sm-3">Correo</dt>
                <dd class="col-sm-9">@Model.correo</dd>

                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9">@Model.Rol?.rol</dd>

                <dt class="col-sm-3">Fecha Registro</dt>
                <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
            </dl>

            <form asp-action="EliminarUsuario" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Sí, eliminar
                    </button>

                    <a asp-action="VerUsuarios" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>