@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var usuario = Context.Session.GetString("usuario");
}
@model List<VentaViewModel>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Detalle de ventas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background-color: #6A5ACD;
                color: white;
            }

            .panel-card {
                background: #111f33;
                border-radius: 18px;
                padding: 25px;
                box-shadow: 0 10px 30px rgba(0,0,0,.35);
            }

            .title {
                color: #FFD700;
                font-weight: bold;
            }

            .table {
                overflow: hidden;
                border-radius: 12px;
            }

            .btn-accent {
                background: #FFD700;
                color: #111;
                font-weight: bold;
                border-radius: 10px;
            }

                .btn-accent:hover {
                    background: #e6c200;
                    color: #111;
                }

            .page-link {
                background: #111f33;
                color: #FFD700;
                border-color: #30415f;
            }

                .page-link:hover {
                    background: #FFD700;
                    color: #111;
                }

            .active-page {
                background: #FFD700 !important;
                color: #111 !important;
                font-weight: bold;
            }
    </style>
</head>
<body>

    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="title mb-1">Detalle de ventas</h2>

                <!-- BOTONES -->
                <a asp-controller="Account" asp-action="Dashboard"
                       class="btn btn-sm btn-light me-2">
                    Dashboard
                </a>

                <a asp-controller="Home" asp-action="Index"
                       class="btn btn-sm btn-light">
                     Home
                </a>
            </div>

            <span class="badge bg-warning-subtle text-dark p-2">
                Admin: @usuario
            </span>

        </div>

        <div class="panel-card mb-4">
            <form method="get" class="row g-3 align-items-end">

                <!-- FECHA DESDE -->
                <div class="col-md-3">
                    <label class="form-label">Desde</label>
                    <input type="date" name="desde" class="form-control"
                           value="@ViewBag.Desde?.ToString("yyyy-MM-dd")" />
                </div>

                <!-- FECHA HASTA -->
                <div class="col-md-3">
                    <label class="form-label">Hasta</label>
                    <input type="date" name="hasta" class="form-control"
                           value="@ViewBag.Hasta?.ToString("yyyy-MM-dd")" />
                </div>

                <!-- CLIENTE -->
                <div class="col-md-3">
                    <label class="form-label">Cliente</label>
                    <input type="text" name="cliente" class="form-control"
                           placeholder="Nombre del cliente..."
                           value="@ViewBag.Cliente" />
                </div>

                <!-- VIDEOJUEGO -->
                <div class="col-md-3">
                    <label class="form-label">Videojuego</label>
                    <input type="text" name="videojuego" class="form-control"
                           placeholder="Nombre del juego..."
                           value="@ViewBag.Videojuego" />
                </div>

                <!-- BOTON FILTRAR -->
                <div class="col-md-6">
                    <button type="submit"
                            asp-action="DetalleVentas"
                            class="btn btn-accent w-100">
                        Filtrar
                    </button>
                </div>

                <!-- BOTON PDF -->
                <div class="col-md-6">
                    <a class="btn btn-danger w-100"
                           asp-action="ExportarPDF"
                           asp-route-desde="@ViewBag.Desde?.ToString("yyyy-MM-dd")"
                           asp-route-hasta="@ViewBag.Hasta?.ToString("yyyy-MM-dd")"
                           asp-route-cliente="@ViewBag.Cliente"
                           asp-route-videojuego="@ViewBag.Videojuego">
                        Exportar PDF
                    </a>
                </div>

            </form>
        </div>

        <div class="panel-card">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle text-center mb-0">
                    <thead class="table-warning text-dark">
                        <tr>
                            <th>Usuario</th>
                            <th>Videojuego</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Código</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NombreCliente</td>
                                <td>@item.NombreVideojuego</td>
                                <td>@item.cantidad</td>
                                <td>$@item.total</td>
                                <td>
                                    <span class="badge bg-success">
                                        @item.estadoCompra
                                    </span>
                                </td>
                                <td>@item.fechaHoraTransacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="text-warning">
                                        @item.codigoTransaccion
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                    {
                        <li class="page-item">
                            <a class="page-link @(ViewBag.PaginaActual == i ? "active-page" : "")"
                                   href="?pagina=@i&desde=@ViewBag.Desde&hasta=@ViewBag.Hasta">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

    </div>

</body>
</html>