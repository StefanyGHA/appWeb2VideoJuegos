@model IEnumerable<appWeb2.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios Registrados";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Usuarios Registrados</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background:#6A5ACD; color:white;">

    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-warning">Usuarios Registrados</h2>

            <div>

                <!-- BOTONES -->
                <a asp-controller="Account" asp-action="Dashboard"
                       class="btn btn-sm btn-light me-2">
                    Dashboard
                </a>

                <a asp-controller="Home" asp-action="Index"
                       class="btn btn-sm btn-light">
                    Home
                </a>
            </div>
        </div>

        <div class="card shadow-lg border-0" style="background:#1e293b;">
            <div class="card-body">

                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr class="text-warning">
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Fecha Registro</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.nombre</td>
                                <td>@item.correo</td>
                                <td>@item.Rol?.rol</td>
                                <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a asp-action="DetalleUsuario" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                        Ver
                                    </a>

                                    <a asp-action="EditarUsuario" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="EliminarUsuario" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</body>
</html>