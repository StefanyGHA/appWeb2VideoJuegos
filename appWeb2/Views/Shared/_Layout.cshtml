@using Microsoft.AspNetCore.Http

@{
    var usuario = Context.Session.GetString("usuario");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameStore</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-dark-custom">

    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold text-warning fs-4" asp-controller="Home" asp-action="Index">
                    <td style="width: 140px; text-align: left; vertical-align: middle;">
                        <img src="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/logoamarillo.png")"
                             style="width: 150px;" />
                    </td>
        
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuNavbar">

                    <!-- MENÚ -->
                    <ul class="navbar-nav me-auto gap-2">

                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Account" asp-action="MisCompras">
                                    Mis Compras
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Account" asp-action="MiCuenta">
                                    Mi Cuenta
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetInt32("Idrol") == 1)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="VideoJuegos" asp-action="Index">
                                    Videojuegos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Account" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Account" asp-action="DetalleVentas">
                                    Ventas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-hover" asp-controller="Account" asp-action="VerUsuarios">
                                    Usuarios
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- USUARIO -->
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white" >
                                    👤Hola, @usuario
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-logout" asp-controller="Account" asp-action="Logout">
                                    Cerrar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-accent" asp-controller="Account" asp-action="Login">
                                    Inicia sesión
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-accent" asp-controller="Account" asp-action="Register">
                                    Registrarse
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
            <style></style>
        </nav>
    </header>


    <section class="banner text-center text-white">
    </section>
    
    <div class="container mt-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
    <footer class="footer-custom text-center py-3 mt-5">
        <div class="container">
            &copy; 2026 - GameStore | Todos los derechos reservados
        </div>
    </footer>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>